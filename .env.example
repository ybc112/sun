# ===== 黄金香蕉发射台 环境变量 =====
# 复制为 .env 后使用。链上变量必须以 VITE_ 开头才能打进前端包。

# —— 链上（默认 BSC 主网，KimiMint v1 factory）——
VITE_CHAIN_ID=56
VITE_MINT_FACTORY_ADDRESS=0xE1CD783bcE52E8945B0FB539AA106aa35b08879e
# 只读数据用的公共 RPC（钱包连接时优先用用户钱包自带的链）
VITE_BSC_RPC_URL=https://bsc.publicnode.com
# 创建费显示的代币精度缩写（BNB / ETH）
VITE_NATIVE_SYMBOL=BNB

# —— 后端（kimimint-backend.mjs）——
# 开发环境走 vite proxy（/api → 8787），生产环境必须填后端公网地址
VITE_BACKEND_URL=
VITE_BACKEND_TARGET=http://localhost:8787

# —— 靓号 ——
# 后端以链上 factory.requiredTokenSuffix=0x7777 为准；
# 只有当你的 KimiMintToken.chain-exact.json（服务器 pristine 文件）在本地也有拷贝时，
# 才填写下面的链上精确 creation bytecode 启用“前端本地挖盐”兜底：
# VITE_TOKEN_CREATION_HEX=0x...
# 靓号挖盐最大尝试次数
VITE_VANITY_MAX_ITERATIONS=600000